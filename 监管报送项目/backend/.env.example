REG_ASSISTANT_APP_NAME=监管规则变更智能落地助手
REG_ASSISTANT_DATABASE_URL=mysql+pymysql://reg_user:reg_pass_123@localhost:3306/reg_reporting?charset=utf8mb4
REG_ASSISTANT_UPLOAD_DIR=./data/uploads
REG_ASSISTANT_MOCK_AI=true

# LLM 网关（chat/completions）
# REG_ASSISTANT_LLM_API_BASE=https://api.example.com/v1
# REG_ASSISTANT_LLM_API_KEY=sk-xxxxxxxx
# REG_ASSISTANT_LLM_MODEL=gpt-5.4
# REG_ASSISTANT_LLM_FALLBACK_MODEL=gpt-5.3-codex
# REG_ASSISTANT_LLM_TIMEOUT_SECONDS=60

# Embedding 服务（OpenAI 兼容协议 /v1/embeddings）
# concept_matcher 路 4 余弦相似度召回依赖这套配置。
# 未配置时 ConceptMatcher 自动降级为路 1 alias + 路 2 definition，不影响 /match。
# 阿里 DashScope 兼容模式：
# REG_ASSISTANT_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# REG_ASSISTANT_EMBEDDING_API_KEY=sk-xxxxxxxx
# REG_ASSISTANT_EMBEDDING_MODEL=text-embedding-v3
# REG_ASSISTANT_EMBEDDING_DIM=1024
# REG_ASSISTANT_EMBEDDING_BATCH_SIZE=25
# REG_ASSISTANT_EMBEDDING_TIMEOUT_SECONDS=30
